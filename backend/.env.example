NODE_ENV=development
PORT=5000
MONGODB_URI=replace-with-your-mongodb-connection-string
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173
USER_TIMEZONE=UTC
WEB_PUSH_PUBLIC_KEY=replace-with-your-web-push-public-key
WEB_PUSH_PRIVATE_KEY=replace-with-your-web-push-private-key
WEB_PUSH_SUBJECT=mailto:admin@example.com
DOSE_REMINDER_LEAD_MINUTES=15
APPOINTMENT_REMINDER_LEAD_HOURS=24,1
DOSE_REMINDER_JOB_ENABLED=true
